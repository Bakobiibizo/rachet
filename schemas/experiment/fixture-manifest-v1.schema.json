{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rachet.invalid/schemas/experiment/fixture-manifest-v1.schema.json",
  "title": "Rachet fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "set": { "enum": ["smoke", "calibration", "formal"] },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "path", "sha256"],
        "properties": {
          "fixture_id": { "$ref": "#/$defs/identifier" },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
