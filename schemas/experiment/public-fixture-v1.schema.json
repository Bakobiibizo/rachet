{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rachet.invalid/schemas/experiment/public-fixture-v1.schema.json",
  "title": "Rachet public validation fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_id", "class", "repository", "specification",
    "artifacts", "claims", "permitted_commands", "resource_limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "$ref": "#/$defs/identifier" },
    "class": {
      "enum": [
        "clean_change", "obvious_regression", "subtle_regression",
        "authorization_defect", "malformed_error_handling",
        "specification_violation", "test_only_failure",
        "misleading_but_valid_change", "genuinely_ambiguous_claim"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "base_commit", "candidate_commit", "integrity_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "base_commit": { "$ref": "#/$defs/gitObjectId" },
        "candidate_commit": { "$ref": "#/$defs/gitObjectId" },
        "integrity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "specification": { "$ref": "#/$defs/artifact" },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement"],
        "properties": {
          "claim_id": { "$ref": "#/$defs/identifier" },
          "statement": { "$ref": "#/$defs/text" }
        }
      }
    },
    "permitted_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/command" }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_seconds", "cpu_seconds", "model_calls", "input_tokens",
        "output_tokens", "tool_calls", "git_objects_read", "files_inspected",
        "tests_executed", "evidence_bytes"
      ],
      "properties": {
        "wall_clock_seconds": { "$ref": "#/$defs/nonNegativeInteger" },
        "cpu_seconds": { "$ref": "#/$defs/nonNegativeInteger" },
        "model_calls": { "$ref": "#/$defs/nonNegativeInteger" },
        "input_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "output_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "tool_calls": { "$ref": "#/$defs/nonNegativeInteger" },
        "git_objects_read": { "$ref": "#/$defs/nonNegativeInteger" },
        "files_inspected": { "$ref": "#/$defs/nonNegativeInteger" },
        "tests_executed": { "$ref": "#/$defs/nonNegativeInteger" },
        "evidence_bytes": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "relativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObjectId": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 1048576 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "media_type", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/relativePath" },
        "media_type": { "$ref": "#/$defs/text" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
